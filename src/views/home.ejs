<%- include('partials/head') %>

<section class="hero">
  <div>
    <h1>Lo que lees. Lo que ves. Lo que opinas.</h1>
    <p class="lead">LeoVeo es una comunidad para reseñar películas y libros.</p>
    <% if (locals.currentUser) { %>
      <p>Has iniciado sesión como <strong>@<%= currentUser.username %></strong>. Muy pronto podrás añadir obras y reseñas.</p>
    <% } else { %>
      <p><a href="/register">Crea una cuenta</a> o <a href="/login">inicia sesión</a>.</p>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
