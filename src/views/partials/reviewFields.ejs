<%
  // Campos compartidos por "nueva reseña" y "editar reseña". Variables: values, errors
  values = values || {};
  errors = errors || {};
%>
<fieldset class="field">
  <legend>Puntuación</legend>
  <div class="star-input">
    <% for (var i = 5; i >= 1; i--) { %>
      <input type="radio" id="rating-<%= i %>" name="rating" value="<%= i %>" <%= String(values.rating) === String(i) ? 'checked' : '' %> required>
      <label for="rating-<%= i %>" title="<%= i %> de 5"><span class="sr-only"><%= i %> de 5</span>★</label>
    <% } %>
  </div>
  <% if (errors.rating) { %><p class="field-error"><%= errors.rating %></p><% } %>
</fieldset>
<div class="field">
  <label for="review-title">Título</label>
  <input id="review-title" name="title" type="text" maxlength="100" required value="<%= values.title || '' %>"
    aria-invalid="<%= !!errors.title %>">
  <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
</div>
<div class="field">
  <label for="review-body">Tu opinión</label>
  <textarea id="review-body" name="body" rows="6" minlength="10" maxlength="3000" required data-counter
    aria-invalid="<%= !!errors.body %>"><%= values.body || '' %></textarea>
  <% if (errors.body) { %><p class="field-error"><%= errors.body %></p><% } %>
</div>
