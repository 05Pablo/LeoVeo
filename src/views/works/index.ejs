<%- include('../partials/head') %>
<%
  var sortLabels = { recientes: 'Más recientes', valoracion: 'Mejor valoradas', populares: 'Más reseñadas', titulo: 'Título (A-Z)' };
  function pageUrl(p) {
    var params = new URLSearchParams();
    if (filters.q) params.set('q', filters.q);
    if (filters.type) params.set('type', filters.type);
    if (filters.genre) params.set('genre', filters.genre);
    if (filters.sort) params.set('sort', filters.sort);
    params.set('page', p);
    return '/works?' + params.toString();
  }
%>

<div class="section-head">
  <h1><%= filters.type === 'pelicula' ? 'Películas' : filters.type === 'libro' ? 'Libros' : 'Explorar' %></h1>
  <span class="muted"><%= result.total %> <%= result.total === 1 ? 'obra' : 'obras' %></span>
</div>

<form class="filters" action="/works" method="GET" role="search">
  <div class="field">
    <label for="q">Buscar</label>
    <input id="q" name="q" type="search" value="<%= filters.q %>" placeholder="Título, director o autor" maxlength="100" autocomplete="off" data-autocomplete>
  </div>
  <div class="field">
    <label for="type">Tipo</label>
    <select id="type" name="type">
      <option value="">Todos</option>
      <option value="pelicula" <%= filters.type === 'pelicula' ? 'selected' : '' %>>Películas</option>
      <option value="libro" <%= filters.type === 'libro' ? 'selected' : '' %>>Libros</option>
    </select>
  </div>
  <div class="field">
    <label for="genre">Género</label>
    <select id="genre" name="genre">
      <option value="">Todos</option>
      <% genres.forEach(function (g) { %>
        <option value="<%= g %>" <%= filters.genre === g ? 'selected' : '' %>><%= g %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="sort">Ordenar</label>
    <select id="sort" name="sort">
      <% sorts.forEach(function (s) { %>
        <option value="<%= s %>" <%= result.sort === s ? 'selected' : '' %>><%= sortLabels[s] %></option>
      <% }) %>
    </select>
  </div>
  <button type="submit" class="btn">Filtrar</button>
</form>

<% if (result.items.length) { %>
  <div class="grid">
    <% result.items.forEach(function (work) { %><%- include('../partials/workCard', { work: work }) %><% }) %>
  </div>
<% } else { %>
  <div class="empty">
    <p>No hay obras que coincidan con la búsqueda.</p>
    <% if (locals.currentUser) { %><a href="/works/new" class="btn">Añadir una obra</a><% } %>
  </div>
<% } %>

<% if (result.pages > 1) { %>
  <nav class="pagination" aria-label="Paginación">
    <% if (result.page > 1) { %><a href="<%= pageUrl(result.page - 1) %>">← Anterior</a><% } %>
    <span>Página <%= result.page %> de <%= result.pages %></span>
    <% if (result.page < result.pages) { %><a href="<%= pageUrl(result.page + 1) %>">Siguiente →</a><% } %>
  </nav>
<% } %>

<%- include('../partials/foot') %>
