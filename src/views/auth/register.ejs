<%- include('../partials/head') %>

<section class="auth-card">
  <h1>Crear cuenta</h1>
  <form action="/register" method="POST" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="username">Nombre de usuario</label>
      <input id="username" name="username" type="text" autocomplete="username" required minlength="3" maxlength="30"
        pattern="[a-zA-Z0-9_]+" value="<%= values.username || '' %>" aria-invalid="<%= !!errors.username %>">
      <p class="hint">De 3 a 30 caracteres: letras, números y guion bajo.</p>
      <% if (errors.username) { %><p class="field-error"><%= errors.username %></p><% } %>
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email || '' %>"
        aria-invalid="<%= !!errors.email %>">
      <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
    </div>
    <div class="field">
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="72"
        aria-invalid="<%= !!errors.password %>">
      <p class="hint">Mínimo 8 caracteres, con al menos una letra y un número.</p>
      <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>
    </div>
    <div class="field">
      <label for="passwordConfirm">Repite la contraseña</label>
      <input id="passwordConfirm" name="passwordConfirm" type="password" autocomplete="new-password" required
        aria-invalid="<%= !!errors.passwordConfirm %>">
      <% if (errors.passwordConfirm) { %><p class="field-error"><%= errors.passwordConfirm %></p><% } %>
    </div>
    <button type="submit" class="btn btn-block">Crear cuenta</button>
  </form>
  <p class="muted center">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
</section>

<%- include('../partials/foot') %>
