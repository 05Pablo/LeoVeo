# Copia este fichero como .env y rellena los valores. .env NUNCA se sube a Git.

# Entorno: development | production
NODE_ENV=development
PORT=3000

# En local sin Docker. Con docker compose se usa mongodb://mongo:27017/leoveo
MONGO_URI=mongodb://localhost:27017/leoveo

# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# true solo si la app se sirve por HTTPS
COOKIE_SECURE=false

# Coste del hash de contraseñas (bcrypt)
BCRYPT_ROUNDS=12
